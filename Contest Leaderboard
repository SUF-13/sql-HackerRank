SELECT h.hacker_id, h.name, s.total_score FROM hackers h JOIN (
SELECT sub.hacker_id, sum(sub.max_score) as total_score FROM (
SELECT s.hacker_id , max(s.score) as max_score FROM Submissions s GROUP BY s.hacker_id, s.challenge_id ) sub GROUP BY sub.hacker_id)
s ON h.hacker_id = s.hacker_id WHERE s.total_score>0 ORDER BY s.total_score DESC, h.hacker_id;
